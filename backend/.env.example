# Copy this file to ".env" and fill in real values. Never commit ".env".

# Environment: development | production
NODE_ENV=development

# Port the API listens on (Render sets this automatically in production)
PORT=5000

# Supabase Postgres connection string.
# Supabase Dashboard -> Connect -> "Session pooler" (works on IPv4 networks).
# Replace [YOUR-PASSWORD] with your database password.
# If the password has special characters (@ : / ? # %) URL-encode them.
DATABASE_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-your-region.pooler.supabase.com:5432/postgres

# Secret used to sign admin JWTs. Must be at least 32 characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string-of-at-least-32-chars

# How long an admin login stays valid (examples: 1h, 8h, 1d)
JWT_EXPIRES_IN=8h

# bcrypt cost factor for hashing admin passwords (10-14)
BCRYPT_SALT_ROUNDS=12

# Used only by "npm run seed:admin" to create the first admin account.
# Password must be 8-72 characters. Run the script again to reset it.
ADMIN_NAME=HunarDesk Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-strong-password

# Frontend origin(s) allowed to call this API (CORS).
# Use a comma-separated list for more than one, e.g. local + deployed.
CLIENT_URL=http://localhost:5173
