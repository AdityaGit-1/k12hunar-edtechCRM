# Copy this file to ".env" for local development.
# Vite only exposes variables that start with VITE_ to the browser,
# so never put secrets in this file.

# Base URL of the HunarDesk API (no trailing slash).
# Local: http://localhost:5000
# Production: your deployed backend URL, e.g. https://hunardesk-api.onrender.com
VITE_API_URL=http://localhost:5000
